apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: nok-bng
  annotations:
    config.kubernetes.io/local-config: "true"
  namespace: nok-bng
info:
  description: observability automation apps for BNG use case
pipeline:
  mutators:
    - image: gcr.io/kpt-fn/set-namespace:v0.4.1
      configMap:
        namespace: nok-bng
    - image: gcr.io/kpt-fn/apply-setters:v0.2.0
      configMap:
        ingress-host: bng.nok.local
        gnmic-version: 0.42.1
        prometheus-version: v2.47.0
        grafana-version: latest
