apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: nok-bng
  annotations:
    config.kubernetes.io/local-config: "true"
  namespace: nok-bng
info:
  description: observability automation apps for BNG use case
pipeline:
  mutators:
    - image: gcr.io/kpt-fn/set-namespace:v0.4.1
      configMap:
        namespace: nok-bng
    - image: gcr.io/kpt-fn/apply-setters:v0.2.0
      configPath: apply-setters.yaml
    - image: gcr.io/kpt-fn/set-annotations:v0.1.4
      configMap:
        netopskube.io/bbm: "true"
        netopskube.io/path: "/metrics"
        netopskube.io/prober: "http"
      selectors:
        - kind: Service
          name: tel-sping
        - kind: Service
          name: gnmic-metrics-svc
    - image: gcr.io/kpt-fn/set-annotations:v0.1.4
      configMap:
        netopskube.io/bbm: "true"
        netopskube.io/prober: "tcp"
      selectors:
        - kind: Service
          name: tel-fb
        - kind: Service
          name: tel-loki
        - kind: Service
          name: tel-pt
    - image: gcr.io/kpt-fn/set-annotations:v0.1.4
      configMap:
        netopskube.io/bbm: "true"
        netopskube.io/prober: "http"
      selectors:
        - kind: Service
          name: grafana-svc
        - kind: Service
          name: nok-apps-portal-service
        - kind: Service
          name: prometheus-svc
        - kind: Service
          name: tel-am
        - kind: Ingress
          name: nok-apps-ingress
        - kind: Ingress
          name: nok-apps-portal-ingress
