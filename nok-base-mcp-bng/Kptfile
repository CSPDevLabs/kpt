apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: mcp-controller
  annotations:
    config.kubernetes.io/local-config: "true"
info:
  description: MCP controller for BNG observability (Prometheus, Loki, nok.dev targets)
pipeline:
  mutators:
    - image: gcr.io/kpt-fn/set-namespace:v0.4.1
      configMap:
        namespace: nok-base
    - image: gcr.io/kpt-fn/apply-setters:v0.2.0
      configPath: apply-setters.yaml
