        "definition": "label_values(goflow2_flow_traffic_packets_total, cluster_id)",
        "query": {
          "query": "label_values(goflow2_flow_traffic_packets_total, cluster_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
