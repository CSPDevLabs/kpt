  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Incoming Packets / sec",
      "description": "Rate of packets received by GoFlow2, grouped by exporter address.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DATASOURCE"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DATASOURCE"
          },
          "editorMode": "code",
          "expr": "sum by (cluster_id, remote_ip) (rate(goflow2_flow_traffic_packets_total{cluster_id=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster_id}} / {{remote_ip}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Incoming Traffic (Mbps)",
      "description": "Ingress traffic rate derived from GoFlow2 received-byte counter.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DATASOURCE"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DATASOURCE"
          },
          "editorMode": "code",
          "expr": "sum by (cluster_id, remote_ip) (rate(goflow2_flow_traffic_bytes_total{cluster_id=~\"$cluster\"}[5m])) * 8 / 1000000",
          "legendFormat": "{{cluster_id}} / {{remote_ip}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
