    {
      "id": 12,
      "title": "Recent Flow Records",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "DS_IPFIX_POSTGRES"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    created_at AS \"Time\",\n    cluster_id AS \"cluster_id\",\n    device AS \"device\",\n    raw_data->>'src_addr' AS \"src_addr\",\n    raw_data->>'dst_addr' AS \"dst_addr\",\n    raw_data->>'proto' AS \"proto\",\n    raw_data->>'etype' AS \"etype\",\n    NULLIF(raw_data->>'bytes', '')::BIGINT AS \"bytes\",\n    NULLIF(raw_data->>'packets', '')::BIGINT AS \"packets\",\n    raw_data->>'src_port' AS \"src_port\",\n    raw_data->>'dst_port' AS \"dst_port\",\n    raw_data->>'in_if' AS \"in_if\",\n    raw_data->>'out_if' AS \"out_if\",\n    raw_data->>'next_hop' AS \"next_hop\"\nFROM public.ipfix_flows\nWHERE $__timeFilter(created_at)\n  AND cluster_id ~ '${cluster:regex}'\n  AND device ~ '${device:regex}'\nORDER BY created_at DESC\nLIMIT 1000;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
