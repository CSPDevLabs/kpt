apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: nok-bbm
  annotations:
    config.kubernetes.io/local-config: "true"
upstream:
  type: git
  git:
    repo: https://github.com/CSPDevLabs/kpt
    directory: /nok-bbm
  updateStrategy: resource-merge
info:
  description: Setup monitoring package aiming to give outlook on the NetOpsKube setup status.
pipeline:
  mutators:
    - image: ghcr.io/kptdev/krm-functions-catalog/set-namespace:v0.4
      configMap:
        namespace: nok-bbm
    - image: ghcr.io/kptdev/krm-functions-catalog/apply-setters:v0.1
      configPath: apply-setters.yaml
